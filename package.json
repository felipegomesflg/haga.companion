{
  "name": "haga-overlay",
  "private": true,
  "version": "0.2.0",
  "description": "Path of Exile 2 companion overlay",
  "author": "FELGOM LTDA",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-zone-locale-map.mjs && node scripts/build-campaign-objectives.mjs && node scripts/dev.mjs",
    "prepare:build": "node scripts/prepare-electron-build.mjs",
    "build": "npm run prepare:build && tsc --noEmit && vite build && node scripts/run-electron-builder.mjs",
    "build:dir": "npm run prepare:build && tsc --noEmit && vite build && node scripts/run-electron-builder.mjs --dir",
    "build:campaign": "node scripts/build-campaign-objectives.mjs",
    "build:campaign-pt": "node scripts/apply-campaign-pt-translations.mjs && node scripts/build-campaign-objectives-pt.mjs",
    "seed:data": "node scripts/build-zone-locale-map.mjs && node scripts/build-campaign-objectives.mjs && node scripts/build-campaign-objectives-pt.mjs && node scripts/run-seed.mjs",
    "decode:pob": "node scripts/decode-pob-share.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
